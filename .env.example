# ─────────────────────────────────────────────
#  AI Query Agent — Environment Configuration
# ─────────────────────────────────────────────

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=erp_system

# LLM Provider: "openai" | "gemini"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.2

# App
APP_ENV=development          # development | production
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Security
API_KEY_HEADER=X-API-Key     # Optional: protect endpoints with an API key
API_SECRET_KEY=              # Leave empty to disable API key auth
